#!/usr/bin/env bash
# Requires Conventional Commits on the first line of the message.
set -euo pipefail
subject="$(head -n1 "$1")"
case "$subject" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    echo "✗ commit message does not follow Conventional Commits:"
    echo "  $subject"
    echo "  e.g.: feat(alarm): add snooze | fix: correct pause | feat!: change database format"
    exit 1
fi
