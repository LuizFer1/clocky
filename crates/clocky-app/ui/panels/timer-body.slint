// Body of the panel window for the timer views, plus the overlay drawn over it ("Cronômetro
// esquecido?" dialog). The view is picked by `TimerUi.view`.
import { Theme } from "../theme.slint";
import { TimerUi } from "timer-ui.slint";
import { StopwatchView } from "stopwatch.slint";
import { CountdownConfigView, CountdownRunView } from "countdown.slint";
import { PomodoroListView, PomodoroTimerView } from "pomodoro.slint";
import { WizardView } from "wizard.slint";
import { OverviewView } from "overview.slint";
import { TimerOverlays } from "overlays.slint";
// M7a: the Alarme panel.
import { AlarmEditorView } from "alarm-editor.slint";

export { TimerOverlays }

// One-line notice with a close button ("Sessão de 00:12:04 registrada").
component NoticeBar inherits Rectangle {
    background: Theme.accent-soft;
    border-radius: Theme.radius-lg;
    height: max(40px, label.preferred-height + 2 * Theme.space-2-5);

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;

        label := Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: TimerUi.notice;
            color: Theme.text;
            font-size: Theme.fs-md;
            wrap: word-wrap;
        }

        Rectangle {
            width: 28px;
            border-radius: Theme.radius-sm;
            background: close.has-hover ? Theme.accent-soft : transparent;
            animate background { duration: Theme.dur-hover; }

            Text {
                text: "×";
                color: Theme.muted;
                font-size: Theme.fs-xl;
            }

            close := TouchArea {
                mouse-cursor: pointer;
                clicked => { TimerUi.dismiss-notice(); }
            }
        }
    }
}

export component TimerBody inherits VerticalLayout {
    if TimerUi.notice != "": VerticalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        padding-top: Theme.space-4;

        NoticeBar { }
    }

    if TimerUi.view == "stopwatch": StopwatchView {

        // Fades in when it appears.

        property <bool> shown: false;

        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.

        property <float> start-opacity;

        init => { self.start-opacity = self.opacity; }

        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }

        opacity: self.shown ? 1 : 0;

        animate opacity { duration: Theme.dur-page; easing: ease-out; }

    }
    if TimerUi.view == "countdown-config": CountdownConfigView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
    if TimerUi.view == "countdown-run": CountdownRunView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
    if TimerUi.view == "pomodoro-list": PomodoroListView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
    if TimerUi.view == "pomodoro-timer": PomodoroTimerView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
    if TimerUi.view == "wizard": WizardView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
    if TimerUi.view == "overview": OverviewView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
    // M7a: the Alarme panel.
    if TimerUi.view == "alarm-editor": AlarmEditorView {
        // Fades in when it appears.
        property <bool> shown: false;
        // Evaluates the opacity once while hidden, so the flip below has a start to animate from.
        property <float> start-opacity;
        init => { self.start-opacity = self.opacity; }
        // Flipped right after creation: set in `init`, the animation would be skipped.
        Timer {
            interval: 1ms;
            triggered => {
                parent.shown = true;
                self.running = false;
            }
        }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-page; easing: ease-out; }
    }
}
