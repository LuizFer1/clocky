// Novo pomodoro (handoff SPEC 2.4, screens 44–47): a 4-segment stepper (Foco · Pausa · Longa ·
// Fluxos), the value with − / + and shortcuts, and the live summary. Step 3 also has the
// auto-start switch; step 4 the optional name and the task.
import { Theme } from "../theme.slint";
import { TimerUi } from "timer-ui.slint";
import { Button, Chip, FieldLabel, Footer, TaskLineView } from "common.slint";

component StepMark inherits VerticalLayout {
    in property <int> index;
    in property <string> label;
    spacing: Theme.space-2;

    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: root.index <= TimerUi.wz-step ? Theme.accent : Theme.line-2;
    }

    Text {
        text: root.label;
        color: root.index == TimerUi.wz-step ? Theme.text : Theme.muted;
        font-size: Theme.fs-sm;
        font-weight: root.index == TimerUi.wz-step ? Theme.fw-medium : Theme.fw-regular;
    }
}

// Round 52px − / + button.
component Bump inherits Rectangle {
    in property <bool> up;
    callback clicked();

    width: Theme.size-button-lg;
    height: Theme.size-button-lg;
    border-radius: self.width / 2;
    border-width: 1px;
    border-color: Theme.line-2;
    background: touch.has-hover ? Theme.accent-soft : transparent;

    Image {
        width: 20px;
        height: 20px;
        source: root.up ? @image-url("../../icons/plus.svg") : @image-url("../../icons/minus.svg");
        colorize: Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 44×26 switch.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Theme.accent : Theme.line-2;

    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.on-accent : Theme.muted;

        animate x { duration: Theme.dur-fade; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component NameField inherits Rectangle {
    height: Theme.size-control;
    border-radius: Theme.radius-lg;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line-2;

    Rectangle {
        x: Theme.space-3-5;
        width: parent.width - 2 * Theme.space-3-5;

        input := TextInput {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            text: TimerUi.wz-name;
            color: Theme.text;
            font-size: Theme.fs-base;
            single-line: true;
            edited => { TimerUi.wz-name-edited(self.text); }
            accepted => { TimerUi.wz-next(); }
        }

        if input.text == "": Text {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            text: TimerUi.wz-name-placeholder;
            color: Theme.muted;
            font-size: Theme.fs-base;
        }
    }
}

export component WizardView inherits VerticalLayout {
    VerticalLayout {
        padding: Theme.space-5;
        // The last step has the name and the task too: tighter, so it fits the panel.
        spacing: TimerUi.wz-step == 3 ? Theme.space-4 : Theme.space-5;

        HorizontalLayout {
            spacing: Theme.space-1;

            StepMark {
                horizontal-stretch: 1;
                index: 0;
                label: "Foco";
            }

            StepMark {
                horizontal-stretch: 1;
                index: 1;
                label: "Pausa";
            }

            StepMark {
                horizontal-stretch: 1;
                index: 2;
                label: "Longa";
            }

            StepMark {
                horizontal-stretch: 1;
                index: 3;
                label: "Fluxos";
            }
        }

        VerticalLayout {
            spacing: Theme.space-2;

            Text {
                text: TimerUi.wz-title;
                color: Theme.text;
                font-size: 22px;
                font-weight: Theme.fw-medium;
            }

            Text {
                text: TimerUi.wz-help;
                color: Theme.muted;
                font-size: Theme.fs-base;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: TimerUi.wz-step == 3 ? 84px : 100px;
            border-radius: Theme.radius-panel;
            background: Theme.field;

            HorizontalLayout {
                padding-left: Theme.space-3-5;
                padding-right: Theme.space-3-5;

                VerticalLayout {
                    alignment: center;

                    Bump {
                        up: false;
                        clicked => { TimerUi.wz-bump(false); }
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Theme.space-1-5;

                    Text {
                        vertical-alignment: center;
                        text: TimerUi.wz-value;
                        color: Theme.text;
                        font-size: Theme.fs-timer-xl;
                        font-weight: Theme.fw-medium;
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 22px;

                        Text {
                            text: TimerUi.wz-unit;
                            color: Theme.muted;
                            font-size: Theme.fs-lg;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Bump {
                        up: true;
                        clicked => { TimerUi.wz-bump(true); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;

            for value in TimerUi.wz-shortcuts: Chip {
                horizontal-stretch: 1;
                text: TimerUi.wz-unit == "min" ? value + " min" : value;
                selected: value == TimerUi.wz-value;
                clicked => { TimerUi.wz-set(value); }
            }
        }

        if TimerUi.wz-step == 2: HorizontalLayout {
            spacing: Theme.space-3;

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: "Iniciar a próxima fase sozinho";
                color: Theme.text;
                font-size: Theme.fs-base;
            }

            Switch {
                on: TimerUi.wz-auto-start;
                toggled => { TimerUi.wz-toggle-auto(); }
            }
        }

        if TimerUi.wz-step == 3: VerticalLayout {
            spacing: Theme.space-2-5;

            FieldLabel {
                text: "Nome";
                hint: "opcional";
            }

            NameField { }

            FieldLabel {
                text: "Tarefa";
                hint: "opcional";
            }

            TaskLineView {
                task: TimerUi.wz-task;
                change => { TimerUi.wz-change-task(); }
            }
        }

        Rectangle {
            height: 46px;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line;

            HorizontalLayout {
                padding-left: Theme.space-3-5;
                padding-right: Theme.space-3-5;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: "Resumo";
                    color: Theme.muted;
                    font-size: Theme.fs-md;
                }

                Text {
                    vertical-alignment: center;
                    text: TimerUi.wz-summary;
                    color: Theme.text;
                    font-size: Theme.fs-base;
                    font-weight: Theme.fw-medium;
                }
            }
        }
    }

    Footer {
        Button {
            horizontal-stretch: 1;
            primary: false;
            text: TimerUi.wz-step == 0 ? "Cancelar" : "Voltar";
            clicked => { TimerUi.wz-back(); }
        }

        Button {
            horizontal-stretch: 1.9;
            text: TimerUi.wz-step == 3 ? "Criar pomodoro" : "Próximo";
            clicked => { TimerUi.wz-next(); }
        }
    }
}
