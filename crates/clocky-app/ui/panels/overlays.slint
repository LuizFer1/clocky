// Drawn over the panel body: the "Cronômetro esquecido?" dialog (not in the handoff screens;
// built from its tokens, spec decision 6). The task picker is the panel window's own.
import { Theme } from "../theme.slint";
import { TimerUi } from "timer-ui.slint";
import { Button } from "common.slint";

component ForgottenDialog inherits Rectangle {
    background: Theme.dark ? #000000b3 : #00000059;

    TouchArea { }

    Rectangle {
        x: Theme.space-5;
        width: parent.width - 2 * Theme.space-5;
        height: card.preferred-height;
        y: max(Theme.space-5, (parent.height - self.height) / 2);
        border-radius: Theme.radius-panel;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line-2;

        card := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-3;

            Text {
                text: "Cronômetro esquecido?";
                color: Theme.text;
                font-size: 17px;
                font-weight: Theme.fw-medium;
            }

            Text {
                text: TimerUi.forgotten-text;
                color: Theme.muted;
                font-size: Theme.fs-md;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-top: Theme.space-2;
                spacing: Theme.space-2-5;

                Button {
                    horizontal-stretch: 1;
                    height: Theme.size-control;
                    primary: false;
                    text: "Descartar";
                    clicked => { TimerUi.forgotten-discard(); }
                }

                Button {
                    horizontal-stretch: 1.4;
                    height: Theme.size-control;
                    text: "Registrar tudo";
                    clicked => { TimerUi.forgotten-record(); }
                }
            }
        }
    }
}

export component TimerOverlays inherits Rectangle {
    if TimerUi.forgotten-visible: ForgottenDialog {
        width: root.width;
        height: root.height;
    }
}
