// Generic floating panel (handoff SPEC 2): 380 wide, header (back · title · option icon), body
// and an optional footer. M5 shows a placeholder body per option; M6b fills the real contents.
// With `picking`, the body is the task picker ("Vincular tarefa", screens 60-61).
// Esc and a click outside (window focus lost, handled in Rust) close it.
import { Theme } from "theme.slint";
import { FabIcon, GhostIcon, PrimaryButton } from "components.slint";
// M6b timer panels: the body and header come from `TimerUi` when its view is set.
import { TimerUi } from "panels/timer-ui.slint";
import { TimerBody, TimerOverlays } from "panels/timer-body.slint";
import { PickerState, TaskPicker } from "task-picker.slint";

// A small header button: an icon (‹ ›) or a label ("+ Novo").
component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    callback clicked();

    height: 28px;
    min-width: 28px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.accent-soft : transparent;
    animate background { duration: Theme.dur-hover; }

    HorizontalLayout {
        padding-left: root.text == "" ? 0px : Theme.space-2;
        padding-right: root.text == "" ? 0px : Theme.space-2;
        spacing: Theme.space-1;
        alignment: center;

        VerticalLayout {
            alignment: center;

            Image {
                width: 14px;
                height: 14px;
                source: root.icon;
                colorize: Theme.muted;
            }
        }

        if root.text != "": Text {
            vertical-alignment: center;
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-sm;
            font-weight: Theme.fw-medium;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Several timers of the panel's kind: ‹ 2/3 › and "+ Novo".
component SiblingControls inherits HorizontalLayout {
    spacing: Theme.space-1;

    if TimerUi.sibling-label != "": HorizontalLayout {
        spacing: 2px;

        if TimerUi.can-cycle: VerticalLayout {
            alignment: center;

            HeaderButton {
                icon: @image-url("../icons/chevron-left.svg");
                clicked => { TimerUi.cycle(false); }
            }
        }

        Text {
            vertical-alignment: center;
            horizontal-alignment: center;
            min-width: 28px;
            text: TimerUi.sibling-label;
            color: Theme.muted;
            font-size: Theme.fs-sm;
        }

        if TimerUi.can-cycle: VerticalLayout {
            alignment: center;

            HeaderButton {
                icon: @image-url("../icons/chevron-right.svg");
                clicked => { TimerUi.cycle(true); }
            }
        }
    }

    if TimerUi.can-new: VerticalLayout {
        alignment: center;

        HeaderButton {
            icon: @image-url("../icons/plus.svg");
            text: "Novo";
            clicked => { TimerUi.new-timer(); }
        }
    }
}

export component PanelWindow inherits Window {
    in property <string> panel-title: "Clocky";
    in property <string> panel-subtitle: "";
    in property <image> panel-icon: @image-url("../icons/clock.svg");
    in property <string> empty-title: "";
    in property <string> empty-text: "";
    // Empty = no button in the body.
    in property <string> action-label: "";
    in property <bool> has-footer: true;
    // The body is the task picker.
    in property <bool> picking;
    in property <length> panel-height: 420px;
    // The tallest the timer views may make the window on this monitor (set from Rust).
    in property <length> height-cap: 800px;
    property <bool> timer-view: !root.picking && TimerUi.view != "";
    callback back();
    callback dismiss();
    callback action();

    title: "Clocky · " + (root.picking ? "Vincular tarefa" : root.panel-title);
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font-sans;
    width: Theme.size-panel-width;
    // Header (64 + 1) plus the timer view, capped; past the cap the view scrolls. Rust reads it
    // to place the window before it is shown (its size is not known yet then).
    out property <length> wanted-height: root.timer-view ? min(65px + timer-body.preferred-height, root.height-cap) : root.panel-height;
    height: root.wanted-height;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.picking) {
                    PickerState.cancel();
                } else {
                    root.dismiss();
                }
                return accept;
            }
            reject
        }

        Rectangle {
            background: Theme.panel;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;

            content := VerticalLayout {
                // Header 64: back · title (+ subtitle) · option icon (continuity of the pill).
                HorizontalLayout {
                    height: 64px;
                    padding-left: Theme.space-2-5;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;

                    VerticalLayout {
                        alignment: center;

                        GhostIcon {
                            icon: @image-url("../icons/chevron-left.svg");
                            clicked => {
                                if (root.picking) {
                                    PickerState.cancel();
                                } else {
                                    root.back();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;

                        Text {
                            text: root.picking ? "Vincular tarefa" : TimerUi.view == "" ? root.panel-title : TimerUi.title;
                            color: Theme.text;
                            font-size: Theme.fs-lg;
                            font-weight: Theme.fw-medium;
                            overflow: elide;
                        }

                        if !root.picking && (TimerUi.view == "" ? root.panel-subtitle : TimerUi.subtitle) != "": Text {
                            text: TimerUi.view == "" ? root.panel-subtitle : TimerUi.subtitle;
                            color: Theme.muted;
                            font-size: Theme.fs-sm;
                        }
                    }

                    if !root.picking && TimerUi.view != "": SiblingControls { }

                    if !root.picking: FabIcon {
                        source: TimerUi.view == "" ? root.panel-icon
                            : TimerUi.icon-kind == "stopwatch" ? @image-url("../icons/stopwatch.svg")
                            : TimerUi.icon-kind == "countdown" ? @image-url("../icons/hourglass.svg")
                            : TimerUi.icon-kind == "pomodoro" ? @image-url("../icons/pomodoro.svg")
                            : TimerUi.icon-kind == "alarm" ? @image-url("../icons/alarm.svg")
                            : @image-url("../icons/eye.svg");
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                if root.picking: TaskPicker {
                    vertical-stretch: 1;
                }

                // M6b: timer views.
                // Always present (sized to 0 when hidden) so the window height can read it.
                Flickable {
                    height: root.timer-view ? root.height - 65px : 0px;
                    visible: root.timer-view;
                    content-height: timer-body.preferred-height;

                    timer-body := TimerBody {
                        width: parent.width;
                        height: self.preferred-height;
                    }
                }

                // Placeholder body (the Alarme panel until M7).
                if !root.picking && TimerUi.view == "": VerticalLayout {
                    vertical-stretch: 1;
                    padding: Theme.space-5;
                    spacing: Theme.space-3;
                    alignment: center;

                    Text {
                        horizontal-alignment: center;
                        text: root.empty-title;
                        color: Theme.text;
                        font-size: Theme.fs-base;
                        font-weight: Theme.fw-medium;
                    }

                    Text {
                        horizontal-alignment: center;
                        text: root.empty-text;
                        color: Theme.muted;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }


                    if root.action-label != "": HorizontalLayout {
                        alignment: center;

                        PrimaryButton {
                            text: root.action-label;
                            has-icon: false;
                            clicked => { root.action(); }
                        }
                    }
                }

                // Footer: top border, padding 14/20/20.
                if root.has-footer && !root.picking && TimerUi.view == "": Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                if root.has-footer && !root.picking && TimerUi.view == "": HorizontalLayout {
                    padding-top: Theme.space-3-5;
                    padding-left: Theme.space-5;
                    padding-right: Theme.space-5;
                    padding-bottom: Theme.space-5;
                    alignment: end;

                    Rectangle {
                        height: Theme.size-control;
                        width: close-label.preferred-width + 2 * Theme.space-5;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line-2;
                        background: close-touch.has-hover ? Theme.accent-soft : transparent;
                        animate background { duration: Theme.dur-hover; }

                        close-label := Text {
                            text: "Fechar";
                            color: Theme.text;
                            font-size: Theme.fs-base;
                            font-weight: Theme.fw-medium;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.dismiss(); }
                        }
                    }
                }
            }

            // M6b: task chooser and dialogs over the body (below the 64 + 1 header).
            if TimerUi.view != "" && !root.picking: TimerOverlays {
                y: 65px;
                width: parent.width;
                height: parent.height - 65px;
            }
        }
    }

    // Gives the keyboard focus to the panel so Esc works right after it opens.
    public function focus-keys() {
        keys.focus();
    }
}
