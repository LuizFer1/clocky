// Task picker "Vincular tarefa" (handoff SPEC 2.6, screens 60-61). A component plus a global,
// so any panel can host it; Rust (`src/picker_ui.rs`) fills `PickerState` and answers its
// callbacks. Clicking a row only stages the choice: "Vincular" confirms, "Cancelar" drops it.
import { Theme } from "theme.slint";
import { ChipRow, DotStyle, PickerRow, PickerRowKind } from "models.slint";
import { DotCell, ProjectChip, TextField } from "widgets.slint";

export global PickerState {
    in-out property <string> query;
    in property <[PickerRow]> rows;
    in property <string> selected-label: "Sem tarefa";
    in property <color> selected-color;
    in property <bool> selected-has-project;
    in property <bool> can-create;
    in property <string> create-label;
    in property <[ChipRow]> create-chips;
    callback query-edited(string);
    callback pick(int);
    // "Sem tarefa".
    callback pick-none();
    // Project of the new task.
    callback pick-project(int);
    // "Sem projeto" for the new task.
    callback pick-no-project();
    callback create();
    callback confirm();
    callback cancel();
}

component CheckMark inherits Image {
    width: 18px;
    height: 18px;
    source: @image-url("../icons/check.svg");
    colorize: Theme.accent-text;
}

component PickerLine inherits Rectangle {
    in property <PickerRow> item;

    height: root.item.kind == PickerRowKind.header ? 38px : 44px;
    border-radius: Theme.radius-md;
    background: root.item.kind != PickerRowKind.header && root.item.selected ? Theme.accent-soft : (touch.has-hover && root.item.kind != PickerRowKind.header ? Theme.accent-soft : transparent);
    animate background { duration: Theme.dur-hover; }

    if root.item.kind == PickerRowKind.header: HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-1-5;
        spacing: Theme.space-2;

        DotCell {
            size: 8px;
            dot-color: root.item.dot == DotStyle.accent ? Theme.accent : (root.item.dot == DotStyle.line ? Theme.line-2 : root.item.color);
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.item.name;
            overflow: elide;
            color: Theme.muted;
            font-size: Theme.fs-xs;
            font-weight: Theme.fw-medium;
            letter-spacing: 0.5px;
        }
    }

    if root.item.kind != PickerRowKind.header: HorizontalLayout {
        padding-left: root.item.kind == PickerRowKind.task ? 28px : Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2-5;

        if root.item.kind == PickerRowKind.none: DotCell {
            size: 8px;
            hollow: true;
            dot-color: Theme.muted;
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.item.name;
            color: root.item.kind == PickerRowKind.none ? Theme.muted : Theme.text;
            font-size: Theme.fs-md;
            overflow: elide;
        }

        if root.item.subtasks != "": Text {
            vertical-alignment: center;
            text: root.item.subtasks;
            color: Theme.muted;
            font-size: Theme.fs-xs;
        }

        if root.item.selected: VerticalLayout {
            alignment: center;

            CheckMark { }
        }
    }

    touch := TouchArea {
        enabled: root.item.kind != PickerRowKind.header;
        mouse-cursor: pointer;
        clicked => {
            if (root.item.kind == PickerRowKind.none) {
                PickerState.pick-none();
            } else {
                PickerState.pick(root.item.id);
            }
        }
    }
}

// "Projeto da nova tarefa": project chips + "Criar tarefa “texto”".
component CreateCard inherits Rectangle {
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.line-2;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2-5;

        Text {
            text: "Projeto da nova tarefa";
            color: Theme.muted;
            font-size: Theme.fs-sm;
        }

        VerticalLayout {
            spacing: Theme.space-1-5;

            for row in PickerState.create-chips: HorizontalLayout {
                alignment: start;
                spacing: Theme.space-1-5;

                for chip in row.chips: ProjectChip {
                    text: chip.name;
                    chip-color: chip.color;
                    no-project: chip.none;
                    active: chip.selected;
                    clicked => {
                        if (chip.none) {
                            PickerState.pick-no-project();
                        } else {
                            PickerState.pick-project(chip.id);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
            border-radius: Theme.radius-md;
            background: Theme.accent;

            Text {
                text: PickerState.create-label;
                color: Theme.on-accent;
                font-size: Theme.fs-md;
                font-weight: Theme.fw-medium;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { PickerState.create(); }
            }
        }
    }
}

// Search, selection chip, list and footer. Fills the panel body.
export component TaskPicker inherits VerticalLayout {
    // Top: search + "Selecionada".
    VerticalLayout {
        padding-top: Theme.space-3-5;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-3;

        Rectangle {
            height: Theme.size-control;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: search.has-focus ? Theme.accent : Theme.line-2;
            background: Theme.field;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2-5;

                VerticalLayout {
                    alignment: center;

                    Image {
                        width: 18px;
                        height: 18px;
                        source: @image-url("../icons/search.svg");
                        colorize: Theme.muted;
                    }
                }

                search := TextField {
                    horizontal-stretch: 1;
                    height: 42px;
                    boxed: false;
                    placeholder: "Buscar ou criar tarefa";
                    text <=> PickerState.query;
                    edited(text) => { PickerState.query-edited(text); }
                    accepted => {
                        if (PickerState.can-create) {
                            PickerState.create();
                        }
                    }
                    cancelled => { PickerState.cancel(); }
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: Theme.space-2;

            Text {
                vertical-alignment: center;
                text: "Selecionada:";
                color: Theme.muted;
                font-size: Theme.fs-sm;
            }

            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: Theme.accent-soft;

                HorizontalLayout {
                    padding-left: Theme.space-2-5;
                    padding-right: Theme.space-2-5;
                    spacing: Theme.space-1-5;

                    DotCell {
                        size: 8px;
                        dot-color: PickerState.selected-has-project ? PickerState.selected-color : Theme.line-2;
                    }

                    Text {
                        vertical-alignment: center;
                        text: PickerState.selected-label;
                        color: Theme.text;
                        font-size: Theme.fs-sm;
                        font-weight: Theme.fw-medium;
                        overflow: elide;
                    }
                }
            }
        }
    }

    Flickable {
        vertical-stretch: 1;
        content-height: max(self.height, list.preferred-height);

        list := VerticalLayout {
            width: parent.width;
            padding-top: Theme.space-2;
            padding-left: Theme.space-2;
            padding-right: Theme.space-2;
            padding-bottom: Theme.space-3;
            spacing: Theme.space-1;
            alignment: start;

            if PickerState.can-create: HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                padding-top: Theme.space-1-5;
                padding-bottom: Theme.space-2;

                CreateCard { }
            }

            for item in PickerState.rows: PickerLine {
                item: item;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.line;
    }

    // Footer: Cancelar (1) · Vincular (2).
    HorizontalLayout {
        padding-top: Theme.space-3-5;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-bottom: Theme.space-4;
        spacing: Theme.space-2-5;

        Rectangle {
            horizontal-stretch: 1;
            height: Theme.size-control;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-2;
            background: cancel-touch.has-hover ? Theme.accent-soft : transparent;
            animate background { duration: Theme.dur-hover; }

            Text {
                text: "Cancelar";
                color: Theme.text;
                font-size: Theme.fs-md;
                font-weight: Theme.fw-medium;
            }

            cancel-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { PickerState.cancel(); }
            }
        }

        Rectangle {
            horizontal-stretch: 2;
            height: Theme.size-control;
            border-radius: Theme.radius-lg;
            background: Theme.accent;

            Text {
                text: "Vincular";
                color: Theme.on-accent;
                font-size: Theme.fs-md;
                font-weight: Theme.fw-medium;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { PickerState.confirm(); }
            }
        }
    }
}
