// Controls of Relatórios and Configurações (not in the handoff: built from its tokens and from
// the alarm editor's segmented control and stepper, screen 10).
import { Theme } from "theme.slint";

// Segmented control: field track, the selected option on panel-2 (screen 10, "Repetição").
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <length> segment-height: 32px;
    callback picked(int);

    height: root.segment-height + 8px;
    border-radius: Theme.radius-lg;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for option[index] in root.options: Rectangle {
            horizontal-stretch: 1;
            min-width: label.preferred-width + 2 * Theme.space-3-5;
            border-radius: Theme.radius-md;
            background: index == root.selected ? Theme.panel-2 : (touch.has-hover ? Theme.accent-soft : transparent);
            border-width: index == root.selected ? 1px : 0px;
            border-color: Theme.line-2;

            label := Text {
                text: option;
                color: index == root.selected ? Theme.text : Theme.muted;
                font-size: Theme.fs-sm;
                font-weight: Theme.fw-medium;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(index); }
            }
        }
    }
}

// Square icon button with a border (period arrows, stepper ends).
export component OutlineIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <length> size: 36px;
    in property <bool> boxed: true;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: Theme.radius-md;
    border-width: root.boxed ? 1px : 0px;
    border-color: Theme.line-2;
    background: root.enabled && touch.has-hover ? Theme.accent-soft : transparent;
    opacity: root.enabled ? 1 : 0.35;

    Image {
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: Theme.text;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// − value + in a bordered box (screen 10, "Soneca").
export component Stepper inherits Rectangle {
    in property <string> value;
    in property <string> unit;
    in property <bool> can-decrease: true;
    in property <bool> can-increase: true;
    callback decrease();
    callback increase();

    height: Theme.size-control;
    min-width: 148px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    background: Theme.field;

    HorizontalLayout {
        padding: 3px;

        OutlineIcon {
            boxed: false;
            size: 36px;
            icon: @image-url("../icons/minus.svg");
            enabled: root.can-decrease;
            clicked => { root.decrease(); }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                vertical-alignment: center;
                text: root.value;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-size: Theme.fs-base;
                font-weight: Theme.fw-medium;
            }

            if root.unit != "": Text {
                vertical-alignment: center;
                text: root.unit;
                color: Theme.muted;
                font-size: Theme.fs-sm;
            }
        }

        OutlineIcon {
            boxed: false;
            size: 36px;
            icon: @image-url("../icons/plus.svg");
            enabled: root.can-increase;
            clicked => { root.increase(); }
        }
    }
}

// 44×26 switch (the size of the alarm toggle of Ativos, SPEC 2.5).
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? Theme.accent : Theme.line-2;
    opacity: root.enabled ? 1 : 0.4;

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? Theme.on-accent : (Theme.dark ? Theme.text : #ffffff);
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;

        animate x { duration: Theme.dur-fade; easing: ease; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// Card of the reports and settings pages: field surface, 1px line border, radius 16.
export component Card inherits Rectangle {
    in property <length> pad: Theme.space-5;

    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;

    VerticalLayout {
        padding: root.pad;
        spacing: Theme.space-3-5;

        @children
    }
}

// Empty state: round chart badge, title and help text, centered in a dashed card.
export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <image> icon: @image-url("../icons/chart.svg");

    min-height: 220px;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.line-2;

    VerticalLayout {
        alignment: center;
        padding: Theme.space-6;
        spacing: Theme.space-2-5;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.accent-soft;

                Image {
                    width: 22px;
                    height: 22px;
                    source: root.icon;
                    colorize: Theme.muted;
                }
            }
        }

        Text {
            horizontal-alignment: center;
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-base;
            font-weight: Theme.fw-medium;
            wrap: word-wrap;
        }

        Text {
            horizontal-alignment: center;
            text: root.text;
            color: Theme.muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}

// Section title of a card ("Aparência", "Tempo por projeto").
export component CardTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> trailing;

    Text {
        horizontal-stretch: 1;
        vertical-alignment: center;
        text: root.text;
        color: Theme.text;
        font-size: Theme.fs-base;
        font-weight: Theme.fw-medium;
    }

    if root.trailing != "": Text {
        vertical-alignment: center;
        text: root.trailing;
        color: Theme.text;
        font-family: Theme.font-mono;
        font-size: 18px;
        font-weight: Theme.fw-semibold;
    }
}
