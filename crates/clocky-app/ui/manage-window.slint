// Manage window (handoff SPEC 3, screens 70-74): sidebar + content (breadcrumb, header with the
// contextual button, page). Below ~800px the sidebar moves to the top and the whole window
// scrolls (screen 74). The data comes from `ManageState` (filled by `src/manage.rs`).
import { Theme } from "theme.slint";
import { DangerButton, SecondaryButton } from "widgets.slint";
import { ManageState } from "manage-state.slint";
import { Header, MoveCard } from "manage-header.slint";
import { Sidebar } from "manage-sidebar.slint";
import { TaskListPage } from "manage-project.slint";
import { AllProjectsPage } from "manage-all.slint";
import { TaskPage } from "manage-task.slint";

// Breadcrumb bar: "Clocky / <crumb>".
component TopBar inherits Rectangle {
    height: Theme.size-control;

    HorizontalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        spacing: Theme.space-2;

        Text {
            vertical-alignment: center;
            text: "Clocky";
            color: Theme.muted;
            font-size: Theme.fs-sm;
        }

        Text {
            vertical-alignment: center;
            text: "/";
            color: Theme.muted;
            font-size: Theme.fs-sm;
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: ManageState.crumb;
            color: Theme.text;
            font-size: Theme.fs-sm;
            font-weight: Theme.fw-medium;
            overflow: elide;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component Content inherits Rectangle {
    background: Theme.app;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-8;
        spacing: Theme.space-6;

        Header { }

        if ManageState.page == 2 && ManageState.moving-task: MoveCard { }

        if ManageState.page == 0: AllProjectsPage { }

        if ManageState.page == 1 || ManageState.page == 3: TaskListPage { }

        if ManageState.page == 2: TaskPage { }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

// Confirmation before deleting (dialogs were not designed in the handoff: same tokens).
component ConfirmDialog inherits Rectangle {
    background: #00000099;

    TouchArea { }

    Rectangle {
        width: min(400px, root.width - 2 * Theme.space-4);
        height: card.preferred-height;
        background: Theme.panel;
        border-radius: Theme.radius-panel;
        border-width: 1px;
        border-color: Theme.line-2;

        card := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-3;

            Text {
                text: ManageState.confirm-title;
                color: Theme.text;
                font-size: Theme.fs-lg;
                font-weight: Theme.fw-medium;
                wrap: word-wrap;
            }

            Text {
                text: ManageState.confirm-text;
                color: Theme.muted;
                font-size: Theme.fs-md;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                padding-top: Theme.space-2;
                spacing: Theme.space-2;

                SecondaryButton {
                    text: "Cancelar";
                    clicked => { ManageState.confirm-cancelled(); }
                }

                DangerButton {
                    text: ManageState.confirm-action;
                    clicked => { ManageState.confirm-accepted(); }
                }
            }
        }
    }
}

export component ManageWindow inherits Window {
    // Below ~800px the sidebar moves to the top (screen 74).
    out property <bool> narrow: self.width < 800px;

    title: "Clocky";
    icon: @image-url("../icons/tray.svg");
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 560px;
    background: Theme.app;
    default-font-family: Theme.font-sans;

    if !root.narrow: HorizontalLayout {
        Sidebar {
            width: 240px;
        }

        Rectangle {
            width: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            horizontal-stretch: 1;

            TopBar { }

            Flickable {
                vertical-stretch: 1;
                content-height: max(self.height, wide-content.preferred-height);

                wide-content := Content {
                    width: parent.width;
                    height: max(parent.height, self.preferred-height);
                }
            }
        }
    }

    if root.narrow: Flickable {
        content-height: max(self.height, narrow-column.preferred-height);

        narrow-column := VerticalLayout {
            width: parent.width;
            height: max(parent.height, self.preferred-height);

            Sidebar {
                compact: true;
            }

            TopBar { }

            Content {
                vertical-stretch: 1;
            }
        }
    }

    if ManageState.confirm-open: ConfirmDialog { }
}
