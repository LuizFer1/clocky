// Tray icon: Slint's built-in SystemTrayIcon (Shell_NotifyIconW on Windows, AppKit on macOS,
// StatusNotifierItem over D-Bus on Linux, without GTK). Menu events arrive on the UI thread.
export component ClockyTray inherits SystemTrayIcon {
    callback open-manage();
    callback show-dock();
    callback quit();

    icon: @image-url("../icons/tray.svg");
    tooltip: "Clocky";

    Menu {
        MenuItem {
            title: "Abrir Gerenciar";
            activated => { root.open-manage(); }
        }

        MenuItem {
            title: "Mostrar ícone flutuante";
            activated => { root.show-dock(); }
        }

        MenuSeparator { }

        MenuItem {
            title: "Sair";
            activated => { root.quit(); }
        }
    }
}
