// Sidebar of the manage window (handoff SPEC 3): brand + "Menu", search, "Todos os projetos",
// PROJETOS with "+" and the project list, settings and reports at the bottom.
import { Theme } from "theme.slint";
import { GhostIcon } from "components.slint";
import { DotCell, TextField } from "widgets.slint";
import { ManageState } from "manage-state.slint";

// Brand: fab-style clock, "Clocky" and the underlined "Menu" link (opens the radial menu).
component Brand inherits HorizontalLayout {
    padding-left: Theme.space-2;
    padding-right: Theme.space-2;
    padding-top: Theme.space-1;
    padding-bottom: Theme.space-4;
    spacing: Theme.space-2-5;

    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: Theme.fab;
        border-width: 1px;
        border-color: Theme.fab-border;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000099 : #0000001f;

        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../icons/clock.svg");
            colorize: Theme.fab-text;
        }
    }

    Text {
        horizontal-stretch: 1;
        vertical-alignment: center;
        text: "Clocky";
        color: Theme.text;
        font-size: Theme.fs-md;
        font-weight: Theme.fw-semibold;
    }

    Rectangle {
        width: menu-label.preferred-width;

        menu-label := Text {
            vertical-alignment: center;
            text: "Menu";
            color: Theme.accent-text;
            font-size: Theme.fs-sm;
            font-weight: Theme.fw-medium;
        }

        Rectangle {
            y: (parent.height + menu-label.preferred-height) / 2 - 1px;
            height: 1px;
            background: Theme.accent-text;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { ManageState.open-menu(); }
        }
    }
}

// Compact search box of the sidebar (36 high, 13px text).
component SidebarSearch inherits Rectangle {
    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.field;
    border-width: 1px;
    border-color: field.has-focus ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: Theme.space-2-5;
        padding-right: Theme.space-2-5;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;

            Image {
                width: 15px;
                height: 15px;
                source: @image-url("../icons/search.svg");
                colorize: Theme.muted;
            }
        }

        field := TextField {
            horizontal-stretch: 1;
            height: 34px;
            boxed: false;
            font-size: Theme.fs-sm;
            placeholder: "Buscar";
            text <=> ManageState.search;
            edited(text) => { ManageState.search-edited(text); }
            cancelled => {
                ManageState.search = "";
                ManageState.search-edited("");
            }
        }
    }
}

// A 40px sidebar row: "Todos os projetos" or a project.
component NavRow inherits Rectangle {
    in property <bool> selected;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.accent-soft : (touch.has-hover ? Theme.accent-soft : transparent);

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    @children
}

export component Sidebar inherits Rectangle {
    // Narrow layout (screen 74): no stretch before the footer.
    in property <bool> compact;

    background: Theme.side;

    VerticalLayout {
        padding-top: Theme.space-4;
        padding-bottom: Theme.space-4;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-1;

        Brand { }

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            padding-bottom: Theme.space-2;

            SidebarSearch { }
        }

        NavRow {
            selected: ManageState.page == 0;
            clicked => { ManageState.show-all(); }

            HorizontalLayout {
                padding-left: Theme.space-2-5;
                padding-right: Theme.space-2-5;
                spacing: Theme.space-2-5;

                VerticalLayout {
                    alignment: center;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("../icons/manage.svg");
                        colorize: Theme.text;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: "Todos os projetos";
                    color: Theme.text;
                    font-size: Theme.fs-md;
                    font-weight: Theme.fw-medium;
                }
            }
        }

        // PROJETOS + "+".
        HorizontalLayout {
            padding-top: Theme.space-4;
            padding-bottom: Theme.space-1-5;
            padding-left: Theme.space-2-5;
            padding-right: Theme.space-1;

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: "PROJETOS";
                color: Theme.muted;
                font-size: Theme.fs-xs;
                font-weight: Theme.fw-medium;
                letter-spacing: 0.6px;
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: plus-touch.has-hover ? Theme.accent-soft : transparent;

                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("../icons/plus.svg");
                    colorize: Theme.muted;
                }

                plus-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ManageState.new-project(); }
                }
            }
        }

        if ManageState.projects.length == 0: HorizontalLayout {
            padding-left: Theme.space-2-5;
            padding-top: Theme.space-1;

            Text {
                text: "Nenhum projeto ainda.";
                color: Theme.muted;
                font-size: Theme.fs-sm;
            }
        }

        for project in ManageState.projects: NavRow {
            selected: project.selected;
            clicked => { ManageState.select-project(project.id); }

            HorizontalLayout {
                padding-left: Theme.space-2-5;
                padding-right: Theme.space-2-5;
                spacing: Theme.space-2-5;

                DotCell {
                    dot-color: project.color;
                }

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: project.name;
                    color: Theme.text;
                    font-size: Theme.fs-md;
                    font-weight: project.selected ? Theme.fw-semibold : Theme.fw-medium;
                    overflow: elide;
                }

                Text {
                    vertical-alignment: center;
                    text: project.open;
                    color: Theme.muted;
                    font-size: Theme.fs-xs;
                }
            }
        }

        if !root.compact: Rectangle {
            vertical-stretch: 1;
        }

        // Settings and reports (screens designed in M7).
        HorizontalLayout {
            alignment: start;
            padding-top: Theme.space-4;
            padding-left: Theme.space-1;
            spacing: Theme.space-1;

            GhostIcon {
                width: 36px;
                height: 36px;
                icon: @image-url("../icons/settings.svg");
            }

            GhostIcon {
                width: 36px;
                height: 36px;
                icon: @image-url("../icons/chart.svg");
            }
        }
    }
}
